-- KUKAN multi-site — per-site database bootstrap (ADR-041)
-- The compose analog of the AWS Custom Resource: run once per site as the
-- postgres superuser. Values are passed as psql variables — :'password' and
-- :"db" are quoted by psql itself, so any generated password is safe (no
-- sed/shell escaping of the SQL):
--
--   docker exec -i kukan-shared-postgres psql -U kukan -d postgres \
--     -v db=kukan_citya -v password='<generated password>' \
--     -f - < docker/multi-site/init-site-db.sql.example
--
-- :"db" doubles as the role name (one concept, kukan_<site>). Idempotence:
-- CREATE ROLE/DATABASE fail if the object exists — safe to treat "already
-- exists" as success. Schema migrations are NOT run here; each site's app
-- containers migrate their own database at startup (advisory lock).

CREATE ROLE :"db" WITH LOGIN PASSWORD :'password';
CREATE DATABASE :"db" OWNER :"db";
REVOKE CONNECT ON DATABASE :"db" FROM PUBLIC;
GRANT CONNECT ON DATABASE :"db" TO :"db";
