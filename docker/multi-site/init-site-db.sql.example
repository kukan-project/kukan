-- KUKAN multi-site — per-site database bootstrap (ADR-041)
-- The compose analog of the AWS Custom Resource: run once per site as the
-- postgres superuser, replacing __SITE__ / __PASSWORD__:
--
--   sed -e 's/__SITE__/citya/g' -e 's/__PASSWORD__/change-me/g' \
--     docker/multi-site/init-site-db.sql.example \
--     | docker exec -i kukan-shared-postgres psql -U kukan -d postgres
--
-- Idempotence: CREATE ROLE/DATABASE fail if the object exists — safe to treat
-- "already exists" as success. Schema migrations are NOT run here; each site's
-- app containers migrate their own database at startup (advisory lock).

CREATE ROLE kukan___SITE__ WITH LOGIN PASSWORD '__PASSWORD__';
CREATE DATABASE kukan___SITE__ OWNER kukan___SITE__;
REVOKE CONNECT ON DATABASE kukan___SITE__ FROM PUBLIC;
GRANT CONNECT ON DATABASE kukan___SITE__ TO kukan___SITE__;
