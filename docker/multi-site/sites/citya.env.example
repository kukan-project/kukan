# KUKAN multi-site — per-site env file template (ADR-041)
# Copy to sites/<site>.env and pass via --env-file (see compose.site.yml).

# Site key: ^[a-z][a-z0-9]{1,15}$ (resource names + PostgreSQL identifiers)
SITE=citya

# Public URL of this site (BETTER_AUTH_URL; must match the Caddyfile vhost)
SITE_URL=https://catalog.city-a.example.jp

# Credentials created by init-site-db.sql.example
SITE_DB_PASSWORD=change-me

# Per-site auth secret: openssl rand -base64 48
SITE_AUTH_SECRET=change-me

# Per-site brand build (ADR-042) — uncomment once the Dockerfile consumes it
# KUKAN_BRAND=city-a

# AI (shared ollama; see compose.shared.yml)
# AI_TYPE=ollama
