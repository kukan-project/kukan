# KUKAN — Caddy Reverse Proxy
#
# Default: HTTP proxy on port 80.
# Edit this file to customize for your environment.
#
# --- TLS with Let's Encrypt (automatic) ---
#
#   catalog.example.com {
#       reverse_proxy web:3000
#   }
#
# --- TLS with custom certificate ---
#
#   catalog.example.lg.jp {
#       tls /certs/cert.pem /certs/key.pem
#       reverse_proxy web:3000
#   }
#
#   Mount certs volume in compose.yml:
#     volumes:
#       - /path/to/certs:/certs:ro
#
# --- IP restriction ---
#
#   :80 {
#       @denied not remote_ip 192.168.0.0/16 10.0.0.0/8
#       respond @denied 403
#       reverse_proxy web:3000
#   }
#
# --- Virtual hosts ---
#
#   catalog.example.com {
#       reverse_proxy web:3000
#   }
#
#   other.example.com {
#       reverse_proxy other-service:8080
#   }

:80 {
	# Compress text responses. The OData feed (ADR-055) hands a BI tool pages of
	# JSON that are megabytes each and compress by roughly ten to one; HTML, CSS
	# and the API's JSON gain by the same token. Matched on content type rather
	# than left to compress everything: the bulk of what this site serves by
	# volume is file downloads — Parquet written with ZSTD, images, archives —
	# and running those through another codec costs CPU to no end.
	#
	# Sign-in and session responses are left as they are: they carry secrets
	# beside text a request can echo, which is what a compression side channel
	# (BREACH) needs, and they are too small to gain anything from it. Next
	# compresses on its own when asked, so the request reaches it asking for
	# identity — removed outright, the proxy transport would add gzip back.
	@auth path /api/auth/*
	request_header @auth Accept-Encoding identity
	@compressible not path /api/auth/*
	encode @compressible {
		zstd
		gzip
		match {
			header Content-Type text/*
			header Content-Type application/json*
			header Content-Type application/xml*
			header Content-Type application/javascript*
			header Content-Type application/manifest+json*
			header Content-Type image/svg+xml*
		}
	}

	reverse_proxy web:3000
}
