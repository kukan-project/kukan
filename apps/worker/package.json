    "@kukan/shared": "workspace:*",
    "@kukan/storage-adapter": "workspace:*",
    "@opensearch-project/opensearch": "^3.6.0",
    "croner": "^10.0.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "officeparser": "^7.5.1",
    "p-limit": "^7.3.1",
