{
  "name": "kukan",
  "version": "0.38.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/kukan-project/kukan.git"
  },
  "bugs": {
    "url": "https://github.com/kukan-project/kukan/issues"
  },
  "homepage": "https://github.com/kukan-project/kukan#readme",
  "type": "module",
  "description": "Knowledge Unified Katalog And Network - A data platform for people and AI: read, query, connect",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run",
    "test:unit": "vitest run --project='!*-integration'",
    "test:integration": "vitest run --project='*-integration'",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:create-user": "pnpm --filter @kukan/db db:create-user --",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,astro}\"",
    "eval:search": "pnpm --filter @kukan/api run eval:search",
    "eval:passages": "pnpm --filter @kukan/api run eval:passages",
    "eval:mcp": "pnpm --filter @kukan/api run eval:mcp",
    "eval:suggest": "pnpm --filter @kukan/api run eval:suggest",
    "bench:lake": "pnpm --filter @kukan/lake run bench:compaction",
    "test:clean": "pnpm --filter @kukan/db-testing test:clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp"
    ],
    "ignoredBuiltDependencies": [
      "tesseract.js"
    ],
    "patchedDependencies": {
      "pdfjs-dist@6.2.108": "patches/pdfjs-dist@6.2.108.patch",
      "officeparser@8.1.0": "patches/officeparser@8.1.0.patch"
    },
    "overrides": {
      "@types/node": "$@types/node",
      "esbuild@<0.28.1": ">=0.28.1 <0.29"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
