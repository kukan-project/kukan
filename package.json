{
  "name": "kukan",
  "version": "0.21.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/kukan-project/kukan.git"
  },
  "bugs": {
    "url": "https://github.com/kukan-project/kukan/issues"
  },
  "homepage": "https://github.com/kukan-project/kukan#readme",
  "type": "module",
  "description": "Knowledge Unified Katalog And Network - Modern CKAN alternative",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run",
    "test:unit": "vitest run --project='!*-integration'",
    "test:integration": "vitest run --project='*-integration'",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:create-user": "pnpm --filter @kukan/db db:create-user --",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,astro}\"",
    "eval:search": "pnpm --filter @kukan/api run eval:search",
    "eval:suggest": "pnpm --filter @kukan/api run eval:suggest",
    "bench:lake": "pnpm --filter @kukan/lake run bench:compaction",
    "test:clean": "pnpm --filter @kukan/db-testing test:clean"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.8.1",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp"
    ],
    "patchedDependencies": {},
    "overrides": {
      "@hono/node-server@<2.0.5": ">=2.0.5 <3",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0 <3",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7 <6",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9 <6",
      "devalue@>=5.6.3 <=5.8.0": ">=5.8.1 <6",
      "esbuild@<0.28.1": ">=0.28.1 <0.29",
      "fast-uri@>=3.0.0 <3.1.5": ">=3.1.5 <4",
      "ip-address@<=10.3.0": ">=10.3.1 <11",
      "js-yaml@>=4.0.0 <4.3.1": ">=4.3.1 <5",
      "nanoid@<3.3.17": ">=3.3.17 <4",
      "pdfjs-dist@<6.2.108": ">=6.2.108 <7",
      "postcss@<8.5.10": ">=8.5.10 <9",
      "protobufjs@<=7.6.4": ">=7.6.5 <8",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2 <7",
      "sharp@<0.35.0": ">=0.35.0 <0.36",
      "svgo@>=4.0.0 <4.0.2": ">=4.0.2 <5",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0 <8"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
