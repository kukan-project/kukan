{
  "name": "kukan",
  "version": "0.11.5",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/kukan-project/kukan.git"
  },
  "bugs": {
    "url": "https://github.com/kukan-project/kukan/issues"
  },
  "homepage": "https://github.com/kukan-project/kukan#readme",
  "type": "module",
  "description": "Knowledge Unified Katalog And Network - Modern CKAN alternative",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "vitest run",
    "test:unit": "vitest run --project='!api-integration'",
    "test:integration": "vitest run --include '**/*.integration.test.ts'",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:create-user": "pnpm --filter @kukan/db db:create-user --",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,astro}\"",
    "eval:search": "pnpm --filter @kukan/api run eval:search",
    "eval:suggest": "pnpm --filter @kukan/api run eval:suggest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "pg": "^8.22.0",
    "prettier": "^3.8.3",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.10.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "prisma",
      "protobufjs",
      "sharp"
    ],
    "patchedDependencies": {},
    "overrides": {
      "undici@>=7.0.0 <7.28.0": ">=7.28.0 <8",
      "devalue@>=5.6.3 <=5.8.0": ">=5.8.1",
      "protobufjs@<=7.6.4": ">=7.6.5 <8",
      "postcss@<8.5.10": ">=8.5.10",
      "qs@>=6.11.1 <=6.15.1": ">=6.15.2",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0",
      "esbuild@<0.28.1": ">=0.28.1",
      "brace-expansion@>=2.0.0 <2.1.2": ">=2.1.2 <3",
      "brace-expansion@>=3.0.0 <5.0.7": ">=5.0.7"
    }
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
