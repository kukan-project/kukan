{
  "name": "@kukan/lake",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "KUKAN DuckLake integration (ADR-043 layer 2: row-level diff)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p src/__tests__",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "bench:compaction": "tsx scripts/bench-compaction.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@kukan/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "tsx": "^4.23.11"
  }
}
