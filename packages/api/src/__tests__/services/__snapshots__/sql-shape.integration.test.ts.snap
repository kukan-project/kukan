// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emitted SQL shape > GET /api/v1/admin/health/stats > pins the sysadmin shape 1`] = `
[
  "select "health_status", count(*) from "resource" where ("resource"."url_type" is null and "resource"."state" = $1 and "resource"."url" IS NOT NULL) group by "resource"."health_status"",
]
`;

exports[`emitted SQL shape > GET /api/v1/admin/jobs/stats > pins the sysadmin shape 1`] = `
[
  "select "status", count(*) from "resource_pipeline" group by "resource_pipeline"."status"",
  "select "resource_pipeline"."resource_id", "resource"."name", "resource_pipeline"."error", "resource_pipeline"."updated" from "resource_pipeline" inner join "resource" on "resource_pipeline"."resource_id" = "resource"."id" where "resource_pipeline"."status" = $1 order by "resource_pipeline"."updated" desc limit $2",
]
`;

exports[`emitted SQL shape > GET /api/v1/admin/search/stats > pins the sysadmin shape 1`] = `
[
  "select count(*) as count from "package" where "package"."state" = $1;",
  "select count(*) from "resource" inner join "package" on "resource"."package_id" = "package"."id" where ("resource"."state" = $1 and "package"."state" = $2)",
]
`;

exports[`emitted SQL shape > GET /api/v1/admin/users/stats > pins the sysadmin shape 1`] = `
[
  "select "state", "role", count(*) from "user" group by "user"."state", "user"."role"",
]
`;

exports[`emitted SQL shape > GET /api/v1/groups > pins the anonymous shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", count(*) over () as "total", (select count(*) from "package_group" inner join "package" on ("package"."id" = "package_group"."package_id" and "package"."state" = $1) where "package_group"."group_id" = "group"."id") as "dataset_count", NULL::int as "member_count" from "group" where "group"."state" = $2 order by "group"."name" asc limit $3",
]
`;

exports[`emitted SQL shape > GET /api/v1/groups > pins the member shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", count(*) over () as "total", (select count(*) from "package_group" inner join "package" on ("package"."id" = "package_group"."package_id" and "package"."state" = $1) where "package_group"."group_id" = "group"."id") as "dataset_count", CASE WHEN exists (select  from "user_group_membership" where ("user_group_membership"."group_id" = "group"."id" and "user_group_membership"."user_id" = $2 and "user_group_membership"."role" in ($3, $4, $5))) THEN (select count(*) from "user_group_membership" where "user_group_membership"."group_id" = "group"."id")::int END as "member_count" from "group" where "group"."state" = $6 order by "group"."name" asc limit $7",
]
`;

exports[`emitted SQL shape > GET /api/v1/groups > pins the sysadmin shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", count(*) over () as "total", (select count(*) from "package_group" inner join "package" on ("package"."id" = "package_group"."package_id" and "package"."state" = $1) where "package_group"."group_id" = "group"."id") as "dataset_count", (select count(*) from "user_group_membership" where "user_group_membership"."group_id" = "group"."id")::int as "member_count" from "group" where "group"."state" = $2 order by "group"."name" asc limit $3",
]
`;

exports[`emitted SQL shape > GET /api/v1/organizations > pins the anonymous shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", count(*) over () as "total", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $1)) as "dataset_count", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $2)) as "deleted_dataset_count", NULL::int as "member_count" from "organization" where "organization"."state" = $3 order by "organization"."name" asc limit $4",
]
`;

exports[`emitted SQL shape > GET /api/v1/organizations > pins the dataset-count ordering shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", count(*) over () as "total", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $1)) as "dataset_count", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $2)) as "deleted_dataset_count", NULL::int as "member_count" from "organization" where "organization"."state" = $3 order by "dataset_count" desc, "organization"."name" asc limit $4",
]
`;

exports[`emitted SQL shape > GET /api/v1/organizations > pins the member shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", count(*) over () as "total", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $1)) as "dataset_count", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $2)) as "deleted_dataset_count", CASE WHEN exists (select  from "user_org_membership" where ("user_org_membership"."organization_id" = "organization"."id" and "user_org_membership"."user_id" = $3 and "user_org_membership"."role" in ($4, $5, $6))) THEN (select count(*) from "user_org_membership" where "user_org_membership"."organization_id" = "organization"."id")::int END as "member_count" from "organization" where "organization"."state" = $7 order by "organization"."name" asc limit $8",
]
`;

exports[`emitted SQL shape > GET /api/v1/organizations > pins the sysadmin shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", count(*) over () as "total", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $1)) as "dataset_count", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $2)) as "deleted_dataset_count", (select count(*) from "user_org_membership" where "user_org_membership"."organization_id" = "organization"."id")::int as "member_count" from "organization" where "organization"."state" = $3 order by "organization"."name" asc limit $4",
]
`;

exports[`emitted SQL shape > GET /api/v1/users/me/organizations > pins the member shape 1`] = `
[
  "select "organization"."id", "organization"."name", "organization"."title", "organization"."description", "organization"."image_url", "organization"."state", "organization"."extras", "organization"."created", "organization"."updated", "user_org_membership"."role", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $1)) as "dataset_count" from "user_org_membership" inner join "organization" on ("user_org_membership"."organization_id" = "organization"."id" and "organization"."state" = $2) where "user_org_membership"."user_id" = $3",
]
`;

exports[`emitted SQL shape > GET /api/v1/users/me/organizations > pins the sysadmin shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", (select count(*) from "package" where ("package"."owner_org" = "organization"."id" and "package"."state" = $1)) as "dataset_count" from "organization" where "organization"."state" = $2",
]
`;

exports[`emitted SQL shape > PackageService.list > pins the list shape 1`] = `
[
  "select "package"."id", "package"."name", "package"."title", "package"."notes", "package"."url", "package"."version", "package"."license_id", "package"."author", "package"."author_email", "package"."maintainer", "package"."maintainer_email", "package"."state", "package"."type", "package"."owner_org", "package"."private", "package"."creator_user_id", "package"."extras", "package"."quality_score", "package"."ai_summary", "package"."ai_tags", "package"."created", "package"."updated", count(*) over () as "total", (select COALESCE(string_agg(DISTINCT UPPER("format"), ',' ORDER BY UPPER("format")), '') from "resource" where ("resource"."package_id" = "package"."id" and "resource"."state" = $1)) as "formats", (select count(*) from "resource" where ("resource"."package_id" = "package"."id" and "resource"."state" = $2)) as "resource_count", (select COALESCE(string_agg("tag"."name", ',' ORDER BY "tag"."name"), '') from "package_tag" inner join "tag" on "tag"."id" = "package_tag"."tag_id" where "package_tag"."package_id" = "package"."id") as "tags_agg", (select COALESCE(string_agg("group"."name" || ':' || COALESCE("group"."title", "group"."name"), ',' ORDER BY "group"."title"), '') from "package_group" inner join "group" on "group"."id" = "package_group"."group_id" where "package_group"."package_id" = "package"."id") as "groups_agg", "organization"."name", "organization"."title" from "package" left join "organization" on "package"."owner_org" = "organization"."id" where "package"."state" = $3 order by "package"."updated" desc limit $4",
]
`;

exports[`emitted SQL shape > ResourceVersionService.countUnversioned > pins the shape 1`] = `
[
  "select count(*) as count from "resource" where ("resource"."state" = $1 and "resource"."hash" IS NOT NULL and NOT EXISTS (SELECT 1 FROM "resource_version" rv WHERE rv.resource_id = "resource"."id") and NOT EXISTS (
        SELECT 1 FROM "resource_pipeline" rp
        WHERE rp.resource_id = "resource"."id" AND rp.status IN ('queued', 'processing')
      ));",
]
`;

exports[`emitted SQL shape > ResourceVersionService.createFirstVersions > pins the scan shape 1`] = `
[
  "select "resource"."id", "resource"."package_id", "resource"."url_type", "resource"."hash", "resource"."size", "resource"."storage_key", "resource_pipeline"."metadata" -> 'schema', (
          "resource_pipeline"."metadata"->>'sourceHash' = "resource"."hash"
          OR (
            "resource_pipeline"."metadata"->>'sourceHash' IS NULL
            AND "resource_pipeline"."status" = 'complete'
            AND exists (select  from "resource_pipeline_step" where ("resource_pipeline_step"."pipeline_id" = "resource_pipeline"."id" and "resource_pipeline_step"."step_name" = $1 and "resource_pipeline_step"."status" = $2))
          )
        ) from "resource" left join "resource_pipeline" on "resource_pipeline"."resource_id" = "resource"."id" where ("resource"."state" = $3 and "resource"."hash" IS NOT NULL and NOT EXISTS (SELECT 1 FROM "resource_version" rv WHERE rv.resource_id = "resource"."id") and NOT EXISTS (
        SELECT 1 FROM "resource_pipeline" rp
        WHERE rp.resource_id = "resource"."id" AND rp.status IN ('queued', 'processing')
      ))",
  "SELECT rv.resource_id AS "resourceId", rv.version, rv.storage_key AS "storageKey", rv.size,
         rv.format
  FROM resource_version rv
  JOIN resource r ON r.id = rv.resource_id
  WHERE r.state = 'active'
    
    AND rv.state = 'active'
    AND rv.ducklake_snapshot_id IS NULL
    AND lower(rv.format) IN ('csv', 'tsv')
    AND rv.size IS NOT NULL
    AND rv.size <= $1
    AND (rv.schema IS NULL OR jsonb_array_length(rv.schema -> 'columns') > 0)
    AND NOT EXISTS (
      SELECT 1 FROM resource_version newer
      WHERE newer.resource_id = rv.resource_id
        AND newer.version > rv.version
        AND newer.state = 'active'
        AND newer.ducklake_snapshot_id IS NOT NULL
    )",
]
`;

exports[`emitted SQL shape > listPurgeTargets > pins the shape 1`] = `
[
  "select "id", exists (select  from "resource_version" where ("resource_version"."resource_id" = "resource"."id" and "resource_version"."ducklake_snapshot_id" is not null)) from "resource" where "resource"."package_id" in ($1)",
]
`;

exports[`emitted SQL shape > readBeforeFirstVersion > pins the shape 1`] = `
[
  "select "storage_key", exists (select  from "resource_version" where "resource_version"."resource_id" = "resource"."id") from "resource" where "resource"."id" = $1 limit $2",
]
`;
