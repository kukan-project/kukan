// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emitted SQL shape > GET /api/v1/groups > pins the anonymous shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", COUNT(*) OVER()::int as "total", (SELECT COUNT(*)::int FROM "package_group" JOIN "package" ON "package"."id" = "package_group"."package_id" AND "package"."state" = 'active' WHERE "package_group"."group_id" = "group"."id") as "dataset_count", NULL::int as "member_count" from "group" where "group"."state" = $1 order by "group"."name" asc limit $2",
]
`;

exports[`emitted SQL shape > GET /api/v1/groups > pins the member shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", COUNT(*) OVER()::int as "total", (SELECT COUNT(*)::int FROM "package_group" JOIN "package" ON "package"."id" = "package_group"."package_id" AND "package"."state" = 'active' WHERE "package_group"."group_id" = "group"."id") as "dataset_count", CASE WHEN EXISTS (SELECT 1 FROM "user_group_membership" WHERE "user_group_membership"."group_id" = "group"."id" AND "user_group_membership"."user_id" = $1 AND "user_group_membership"."role" IN ($2, $3, $4)) THEN (SELECT COUNT(*)::int FROM "user_group_membership" WHERE "user_group_membership"."group_id" = "group"."id") END as "member_count" from "group" where "group"."state" = $5 order by "group"."name" asc limit $6",
]
`;

exports[`emitted SQL shape > GET /api/v1/groups > pins the sysadmin shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", COUNT(*) OVER()::int as "total", (SELECT COUNT(*)::int FROM "package_group" JOIN "package" ON "package"."id" = "package_group"."package_id" AND "package"."state" = 'active' WHERE "package_group"."group_id" = "group"."id") as "dataset_count", (SELECT COUNT(*)::int FROM "user_group_membership" WHERE "user_group_membership"."group_id" = "group"."id") as "member_count" from "group" where "group"."state" = $1 order by "group"."name" asc limit $2",
]
`;

exports[`emitted SQL shape > GET /api/v1/organizations > pins the anonymous shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", COUNT(*) OVER()::int as "total", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'active') as "dataset_count", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'deleted') as "deleted_dataset_count", NULL::int as "member_count" from "organization" where "organization"."state" = $1 order by "organization"."name" asc limit $2",
]
`;

exports[`emitted SQL shape > GET /api/v1/organizations > pins the dataset-count ordering shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", COUNT(*) OVER()::int as "total", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'active') as "dataset_count", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'deleted') as "deleted_dataset_count", NULL::int as "member_count" from "organization" where "organization"."state" = $1 order by "dataset_count" desc, "organization"."name" asc limit $2",
]
`;

exports[`emitted SQL shape > GET /api/v1/organizations > pins the member shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", COUNT(*) OVER()::int as "total", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'active') as "dataset_count", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'deleted') as "deleted_dataset_count", CASE WHEN EXISTS (SELECT 1 FROM "user_org_membership" WHERE "user_org_membership"."organization_id" = "organization"."id" AND "user_org_membership"."user_id" = $1 AND "user_org_membership"."role" IN ($2, $3, $4)) THEN (SELECT COUNT(*)::int FROM "user_org_membership" WHERE "user_org_membership"."organization_id" = "organization"."id") END as "member_count" from "organization" where "organization"."state" = $5 order by "organization"."name" asc limit $6",
]
`;

exports[`emitted SQL shape > GET /api/v1/organizations > pins the sysadmin shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", COUNT(*) OVER()::int as "total", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'active') as "dataset_count", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'deleted') as "deleted_dataset_count", (SELECT COUNT(*)::int FROM "user_org_membership" WHERE "user_org_membership"."organization_id" = "organization"."id") as "member_count" from "organization" where "organization"."state" = $1 order by "organization"."name" asc limit $2",
]
`;

exports[`emitted SQL shape > GET /api/v1/users/me/organizations > pins the member shape 1`] = `
[
  "select "organization"."id", "organization"."name", "organization"."title", "organization"."description", "organization"."image_url", "organization"."state", "organization"."extras", "organization"."created", "organization"."updated", "user_org_membership"."role", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'active') as "dataset_count" from "user_org_membership" inner join "organization" on ("user_org_membership"."organization_id" = "organization"."id" and "organization"."state" = $1) where "user_org_membership"."user_id" = $2",
]
`;

exports[`emitted SQL shape > GET /api/v1/users/me/organizations > pins the sysadmin shape 1`] = `
[
  "select "id", "name", "title", "description", "image_url", "state", "extras", "created", "updated", 'admin' as "role", (SELECT COUNT(*)::int FROM "package" WHERE "package"."owner_org" = "organization"."id" AND "package"."state" = 'active') as "dataset_count" from "organization" where "organization"."state" = $1",
]
`;

exports[`emitted SQL shape > PackageService.list > pins the list shape 1`] = `
[
  "select "package"."id", "package"."name", "package"."title", "package"."notes", "package"."url", "package"."version", "package"."license_id", "package"."author", "package"."author_email", "package"."maintainer", "package"."maintainer_email", "package"."state", "package"."type", "package"."owner_org", "package"."private", "package"."creator_user_id", "package"."extras", "package"."quality_score", "package"."ai_summary", "package"."ai_tags", "package"."created", "package"."updated", COUNT(*) OVER()::int as "total", (SELECT COALESCE(string_agg(DISTINCT UPPER("resource"."format"), ',' ORDER BY UPPER("resource"."format")), '') FROM "resource" WHERE "resource"."package_id" = "package"."id" AND "resource"."state" = 'active') as "formats", (SELECT COUNT(*)::int FROM "resource" WHERE "resource"."package_id" = "package"."id" AND "resource"."state" = 'active') as "resource_count", (SELECT COALESCE(string_agg("tag"."name", ',' ORDER BY "tag"."name"), '') FROM "package_tag" JOIN "tag" ON "tag"."id" = "package_tag"."tag_id" WHERE "package_tag"."package_id" = "package"."id") as "tags_agg", (SELECT COALESCE(string_agg("group"."name" || ':' || COALESCE("group"."title", "group"."name"), ',' ORDER BY "group"."title"), '') FROM "package_group" JOIN "group" ON "group"."id" = "package_group"."group_id" WHERE "package_group"."package_id" = "package"."id") as "groups_agg", "organization"."name", "organization"."title" from "package" left join "organization" on "package"."owner_org" = "organization"."id" where "package"."state" = $1 order by "package"."updated" desc limit $2",
]
`;
