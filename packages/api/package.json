{
  "name": "@kukan/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "KUKAN API Server (Hono)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./adapters": "./dist/adapters.js",
    "./services/search/search-index": "./dist/services/search/search-index.js",
    "./services/search/resource-embedding": "./dist/services/search/resource-embedding.js",
    "./services/pipeline/pipeline-service": "./dist/services/pipeline/pipeline-service.js",
    "./services/odata/row-group-backfill": "./dist/services/odata/row-group-backfill.js",
    "./services/lake/lake-ingest": "./dist/services/lake/lake-ingest.js",
    "./services/lake/lake-reclaim": "./dist/services/lake/lake-reclaim.js",
    "./config": "./dist/config.js",
    "./services/child/host": "./dist/services/child/host.js",
    "./services/child/serve": "./dist/services/child/serve.js",
    "./services/pipeline/pipeline-claim": "./dist/services/pipeline/pipeline-claim.js",
    "./services/concurrency/advisory-lock": "./dist/services/concurrency/advisory-lock.js",
    "./services/pipeline/storage-pointer": "./dist/services/pipeline/storage-pointer.js",
    "./services/organization-service": "./dist/services/organization-service.js",
    "./services/resource-version-service": "./dist/services/resource-version-service.js",
    "./services/search/content-index-record": "./dist/services/search/content-index-record.js",
    "./services/suggest/materials": "./dist/services/suggest/materials.js",
    "./services/suggest/prompt": "./dist/services/suggest/prompt.js",
    "./services/suggest/summary-prompt": "./dist/services/suggest/summary-prompt.js",
    "./services/system-setting": "./dist/services/system-setting.js",
    "./services/ai/resource-summary-service": "./dist/services/ai/resource-summary-service.js"
  },
  "scripts": {
    "dev:standalone": "tsx watch src/server.ts",
    "build": "tsc && esbuild src/services/query/query-child.ts --bundle --platform=node --format=esm --target=node24 --external:@duckdb/node-api --outfile=dist/services/query/query-child.mjs --log-level=warning",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p src/__tests__",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "eval:search": "tsx scripts/eval-search.ts",
    "eval:passages": "tsx scripts/eval-passages.ts",
    "eval:mcp": "tsx scripts/eval-mcp.ts",
    "eval:suggest": "tsx scripts/eval-suggest.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.5-r.5",
    "@google-analytics/data": "^7.2.1",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-validator": "^0.9.1",
    "@kukan/ai-adapter": "workspace:*",
    "@kukan/db": "workspace:*",
    "@kukan/lake": "workspace:*",
    "@kukan/queue": "workspace:*",
    "@kukan/search-adapter": "workspace:*",
    "@kukan/shared": "workspace:*",
    "@kukan/storage-adapter": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-auth": "1.7.7",
    "busboy": "^1.6.0",
    "dotenv": "^18.0.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@kukan/db-testing": "workspace:*",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.3",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "undici": "^8.11.2"
  }
}
