{
  "name": "@kukan/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "KUKAN API Server (Hono)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./adapters": "./dist/adapters.js",
    "./services/search-index": "./dist/services/search-index.js",
    "./services/pipeline-service": "./dist/services/pipeline-service.js",
    "./services/package-cleanup": "./dist/services/package-cleanup.js",
    "./services/organization-service": "./dist/services/organization-service.js"
  },
  "scripts": {
    "dev:standalone": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "eval:search": "tsx scripts/eval-search.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@google-analytics/data": "^6.1.0",
    "@hono/node-server": "^2.0.4",
    "@hono/zod-validator": "^0.8.0",
    "@kukan/ai-adapter": "workspace:*",
    "@kukan/db": "workspace:*",
    "@kukan/queue-adapter": "workspace:*",
    "@kukan/search-adapter": "workspace:*",
    "@kukan/shared": "workspace:*",
    "@kukan/storage-adapter": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-auth": "1.6.15",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "kysely": "^0.29.0",
    "pg": "^8.21.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "js-yaml": "^4.1.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.3"
  }
}
