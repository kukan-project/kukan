{
  "name": "@kukan/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "KUKAN API Server (Hono)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./adapters": "./dist/adapters.js",
    "./services/search-index": "./dist/services/search-index.js",
    "./services/pipeline-service": "./dist/services/pipeline-service.js",
    "./services/lake-ingest": "./dist/services/lake-ingest.js",
    "./services/pipeline-claim": "./dist/services/pipeline-claim.js",
    "./services/advisory-lock": "./dist/services/advisory-lock.js",
    "./services/storage-pointer": "./dist/services/storage-pointer.js",
    "./services/organization-service": "./dist/services/organization-service.js",
    "./services/resource-version-service": "./dist/services/resource-version-service.js",
    "./services/content-index-record": "./dist/services/content-index-record.js"
  },
  "scripts": {
    "dev:standalone": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts && tsc --noEmit -p src/__tests__",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "eval:search": "tsx scripts/eval-search.ts",
    "eval:suggest": "tsx scripts/eval-suggest.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.4-r.1",
    "@google-analytics/data": "^6.1.0",
    "@hono/node-server": "^2.0.12",
    "@hono/zod-validator": "^0.9.0",
    "@kukan/ai-adapter": "workspace:*",
    "@kukan/db": "workspace:*",
    "@kukan/lake": "workspace:*",
    "@kukan/queue-adapter": "workspace:*",
    "@kukan/search-adapter": "workspace:*",
    "@kukan/shared": "workspace:*",
    "@kukan/storage-adapter": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-auth": "1.6.25",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@kukan/db-testing": "workspace:*",
    "@types/node": "^24.12.2",
    "@types/pg": "^8.20.0",
    "js-yaml": "^5.2.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1"
  }
}
