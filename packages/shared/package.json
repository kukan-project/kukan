{
  "name": "@kukan/shared",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "KUKAN shared types, validators, utilities",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/__tests__",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@zxcvbn-ts/core": "^4.1.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/language-ja": "^4.1.1",
    "chardet": "^2.2.0",
    "encoding-japanese": "^2.2.0",
    "lru-cache": "~11.5.2",
    "pino": "^10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^24.12.2",
    "pino-pretty": "^13.1.3"
  }
}
