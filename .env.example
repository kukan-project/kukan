# KUKAN Environment Variables
# Copy this file to .env and adjust values for your environment

# Node.js Environment
NODE_ENV=development
PORT=3000

# Site time zone (IANA name). Times are prerendered in this zone; the browser
# then shows them in the viewer's. Default: Asia/Tokyo
# TIME_ZONE=Asia/Tokyo

# Database (POSTGRES_* → DATABASE_URL is constructed internally)
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=kukan
# POSTGRES_USER=kukan
# POSTGRES_PASSWORD=kukan
# POSTGRES_SSLMODE=disable

# DB Connection Pool — Web (API): defaults max=5, idle=30s, connect=3s
# WEB_DB_POOL_MAX=5
# WEB_DB_POOL_IDLE_TIMEOUT_MS=30000
# WEB_DB_POOL_CONNECTION_TIMEOUT_MS=3000

# DB Connection Pool — Worker: defaults max=3, idle=10s, connect=30s
# WORKER_DB_POOL_MAX=3
# WORKER_DB_POOL_IDLE_TIMEOUT_MS=10000
# WORKER_DB_POOL_CONNECTION_TIMEOUT_MS=30000

# Storage (S3-compatible: AWS S3 or MinIO, determined by S3_ENDPOINT)
# Omit S3_ENDPOINT to use default AWS endpoint (use IAM role)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=kukan-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# S3_REGION=ap-northeast-1

# Search (opensearch recommended; postgres fallback for cost savings)
SEARCH_TYPE=opensearch
OPENSEARCH_URL=http://localhost:9200
# OPENSEARCH_REPLICAS=0
# Index name prefix (`<prefix>-search`) — per-site isolation on a shared domain (ADR-041)
# OPENSEARCH_INDEX_PREFIX=kukan
# Local OpenSearch heap (compose default: 2g). Setting it lower risks the 95%
# circuit breaker under concurrent search once the content index has data
# OPENSEARCH_JAVA_OPTS=-Xms2g -Xmx2g
# Minimum cosine similarity for vector-search hits. Omit → the embedding model's
# measured recommendation (bge-m3 0.45 / Titan v2 0.15 / Cohere v4 0.3);
# unmeasured models fall back to 0.45
# SEARCH_VECTOR_MIN_SIMILARITY=0.45

# Queue (SQS-compatible: AWS SQS or ElasticMQ, determined by SQS_ENDPOINT)
# Omit SQS_ENDPOINT and SET SQS_REGION to use default AWS endpoint (use IAM role)
# SQS_REGION=ap-northeast-1
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/kukan-pipeline
SQS_ACCESS_KEY=x
SQS_SECRET_KEY=x

# Health Check (worker link checker; defaults shown)
# HEALTH_CHECK_ENABLED=true
# HEALTH_CHECK_CRON=*/5 * * * *
# HEALTH_CHECK_STALENESS_HOURS=24
# HEALTH_CHECK_FULL_FETCH_INTERVAL_HOURS=168

# AI (none = disabled; embedding requires bedrock/openai/ollama)
AI_TYPE=none

# AWS: AI_TYPE=bedrock (embedding default: amazon.titan-embed-text-v2:0)
# BEDROCK_REGION=ap-northeast-1

# Dev/on-prem: AI_TYPE=ollama (embedding default: bge-m3)
# Ollama starts with the default compose stack; ollama-init pulls the model
# automatically when AI_TYPE=ollama (closed networks: pre-distribute the volume)
# OLLAMA_PORT: host port compose publishes the ollama container on (11434 inside
# the network). Change OLLAMA_URL and OLLAMA_PORT together; native Ollama: :11434.
# OLLAMA_PORT=11435
# OLLAMA_URL=http://localhost:11435

# OpenAI-compatible endpoint (self-hosted vLLM / HuggingFace TEI etc. via
# OPENAI_BASE_URL). Officially supported backends are bedrock and ollama.
# AI_TYPE=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Override embedding model/dimensions (adapter defaults when omitted).
#
# **Set the model to match what the deployment you compare against runs.** The
# adapter default on Bedrock is Titan v2, and a golden-set run on one model does
# not carry to the other: measured on the same catalogue, Cohere v4 reached
# nDCG 87% against Titan's 84%, and natural-language queries 100% recall against
# 95% (ADR-034, ADR-053 §8.1). A development environment left on the default
# measures something production does not do.
#
# The similarity floor follows the model — the adapter carries a measured one
# per model (0.3 for cohere.embed-v4, 0.15 for titan-embed-text-v2), so it does
# not need setting alongside.
#
# Dimensions default to 1024, which both of those models support. Changing them
# changes `embedding_model` (recorded as `model@dimensions`), so the vectors are
# rebuilt on the next reindex; changing the model does the same.
# AI_EMBEDDING_MODEL=cohere.embed-v4:0
# AI_EMBEDDING_DIMENSIONS=

# Completion models approved for this deployment (comma-separated). Becomes
# the admin picker options + allow-list; the first entry is the provider
# default. Models available on the server but not listed here are not offered.
# With ollama, compose's ollama-init pulls every listed model automatically.
# Omitted → the built-in default only (ollama gemma4:e4b / openai gpt-4o-mini).
# On AWS this is CDK-managed (bedrock.completionModels in environments.ts).
# AI_COMPLETION_MODELS=

# AI-written resource abstracts (ADR-053): the model to write them with, and
# by its absence the switch that turns them off. Must be one of the models in
# AI_COMPLETION_MODELS above; anything else is refused rather than replaced by
# a default.
#
# One setting rather than a flag and a model, because they are one decision —
# what this deployment will spend — and the bill falls on whoever deploys the
# site, not on the administrator who would flip a toggle. Between models it is
# a threefold difference in cost and, measured, the difference between reading
# a scanned page and inventing one.
#
# Unset writes nothing and costs nothing; a site that sets it later builds the
# abstracts from the admin screen. The generation language is a runtime setting
# (Settings -> ai-summary-locale), because choosing a language is free.
# AI_SUMMARY_MODEL=jp.anthropic.claude-sonnet-4-6

# Authentication (Better Auth)
# Generate a secure random string: openssl rand -base64 32
BETTER_AUTH_SECRET=change-this-to-at-least-32-characters-secret-key
BETTER_AUTH_URL=http://localhost:3000

# Password strength floor: the zxcvbn score (0-4) a new password must reach.
# Defaults to 3 ("safely unguessable"); the 15 character minimum applies
# whatever this is set to.
# DEVELOPMENT ONLY — never set this in production. 0 drops the guessability
# check entirely, so that scratch passwords stay usable on a local machine.
# PASSWORD_MIN_SCORE=0

# Trusted Origins (comma-separated, for CORS in standalone API mode)
# TRUSTED_ORIGINS=http://localhost:3000

# GA4 Analytics (optional — dashboard disabled when not set)
# GA4_PROPERTY_ID=123456789
# GA4_CLIENT_EMAIL=sa@project-id.iam.gserviceaccount.com
# GA4_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n

# Logging (pino structured logging)
# LOG_LEVEL: trace, debug, info, warn, error, fatal (default: info)
# LOG_LEVEL=info
