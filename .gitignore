yarn-error.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# AI agent skills
.agents/skills/
skills-lock.json

# OS
.DS_Store
Thumbs.db

# Astro
.astro/

# Turbo
.turbo/

# CDK
cdk.out/
# Note: config/environments.ts and cdk.context.json are NOT ignored — forks commit both so
# CodeBuild synth is hermetic. Upstream commits neither (it ships environments.example.ts as
# the fallback; context resolves via the lookup role when cdk.context.json is absent). ADR-031.

# Database
*.db
*.sqlite
*.sqlite3

# Sample seed data (local only)
seed-sample-*

# Search-quality golden set (deployment-specific — copy from golden-queries.example.yaml)
packages/api/scripts/golden-queries.yaml

# Suggestion-quality golden set and its report (deployment-specific)
packages/api/scripts/golden-suggest.yaml
packages/api/scripts/eval-suggest-report*.md

# Temporary files
tmp/
temp/
*.tmp

# Local Docker Compose overrides (e.g. GPU passthrough for Ollama)
compose.override.yml
