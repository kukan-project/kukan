    <script is:inline define:vars={{ translations: t, base }}>
      (function () {
        function getLocale() {
          return document.documentElement.dataset.locale || 'en'
        }

        function applyLocale(lang) {
          var tr = translations[lang]
          document.documentElement.lang = lang
          document.documentElement.dataset.locale = lang
          localStorage.setItem('kukan-locale', lang)

          // Update title and meta
          var title = document.querySelector('title')
          if (title) title.textContent = title.dataset[lang]
          document.querySelectorAll('meta[data-' + lang + ']').forEach(function (el) {
            el.setAttribute('content', el.dataset[lang])
          })

          // Update text content
          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            var key = el.dataset.i18n
            var value = key.split('.').reduce(function (obj, k) { return obj && obj[k] }, tr)
            if (value) el.textContent = value
          })

          // Update innerHTML (for <br> etc.)
          document.querySelectorAll('[data-i18n-html]').forEach(function (el) {
            var key = el.dataset.i18nHtml
            var value = key.split('.').reduce(function (obj, k) { return obj && obj[k] }, tr)
            if (value) el.innerHTML = value
          })

          // Update doc links to point to correct locale
          var docsBase = base + lang + '/'
          var docsLink = document.getElementById('docs-link')
          var ctaLink = document.getElementById('cta-link')
          var docsNav = document.querySelector('[data-i18n="docs"]')
          if (docsLink) docsLink.href = docsBase
          if (ctaLink) ctaLink.href = docsBase
          if (docsNav) docsNav.href = docsBase
          document.querySelectorAll('[data-doc]').forEach(function (el) {
            var doc = el.dataset.doc.split('.').reduce(function (obj, k) { return obj && obj[k] }, tr)
            if (doc) el.href = docsBase + doc.guide + '/' + (doc.hash ? '#' + doc.hash : '')
          })
        }

        // Apply on load (for ja, since head script already ran; reinforce with full DOM)
        var currentLang = getLocale()
        if (currentLang === 'ja') {
          applyLocale('ja')
        }

        // Language switch button
        var btn = document.getElementById('lang-switch')
        if (btn) {
          btn.addEventListener('click', function () {
            var next = getLocale() === 'ja' ? 'en' : 'ja'
            applyLocale(next)
          })
        }
      })()
    </script>

