---
import { version } from '../../../package.json'
import changelog from '../../../CHANGELOG.md?raw'

// The release date as CHANGELOG.md records it for this version; absent while
// the release entry has not landed yet, and the button then shows the version
// alone.
const releasedOn = changelog.match(
  new RegExp(`^## \\[${version.replaceAll('.', '\\.')}\\] - (\\d{4}-\\d{2}-\\d{2})`, 'm')
)?.[1]

const rawBase = import.meta.env.BASE_URL
const base = rawBase.endsWith('/') ? rawBase : rawBase + '/'
const brand = 'hsl(214, 81%, 54%)'
const dark = 'hsl(214, 44%, 18%)'

type Locale = 'ja' | 'en'

const t = {
  ja: {
    title: 'KUKAN — みんなが使えるデータカタログ',
    description:
      'Knowledge Unified Katalog And Network — 読めて、問えて、つながる。人と AI のためのオープンソースのデータ基盤',
    tagline: 'みんなが使えるデータカタログ',
    heroDesc: '読めて、問えて、つながる。人と AI のためのデータ基盤',
    docs: 'ドキュメント',
    readDocs: 'ドキュメントを読む',
    viewOnGitHub: 'GitHub で見る',
    liveDemo: 'デモサイトを見る',
    pillarsTitle: '読めて、問えて、つながる。',
    pillarsLead: '公開して終わりにせず、データが使われるところまで面倒を見ます。',
    recentTitle: '最近の更新',
    foundationTitle: '運用の土台',
    plannedNote: '今後の予定: SSO 連携（OIDC）、CSV の列型の確定と差分への反映。',
    learnMore: '詳しく見る',
    techTitle: '技術スタック',
    ctaTitle: 'さっそく始めてみましょう',
    ctaDesc: '詳細なセットアップ手順はドキュメントをご覧ください。',
    ctaButton: 'ドキュメントへ',
    ctaNote: '開発の背景についてはこちら',
    releaseNotes: 'リリースノート',
    switchLang: 'English',
    recent: [
      { title: 'BI ツールから直接つなぐ', doc: { guide: 'user-guide', hash: 'bi-ツールで開く' } },
      { title: 'ファイル内容の自動説明', doc: { guide: 'data-admin-guide', hash: 'ai-による説明抄録' } },
      { title: 'リソース単位のハイブリッド検索', doc: { guide: 'user-guide', hash: 'どのリソースが一致したか' } },
    ],
    pillars: [
      {
        word: '読める',
        lead: '中身を解釈して、人にも AI にも分かる形で見せます。',
        items: [
          {
            title: '中身を読んで、説明を書く',
            desc: 'リソースを登録すると、AI が中身を読んで短い説明を書きます。表は列の構成と先頭の行から、PDF や Office 文書は本文から。タイトル・説明・タグの提案も同じ素材から起こし、フィールド単位で確認して採用します。',
            doc: { guide: 'data-admin-guide', hash: 'ai-による説明抄録' },
          },
          {
            title: 'ファイルの中まで探す',
            desc: 'キーワードと意味を合わせたハイブリッド検索で、データセットではなくファイル単位に当たります。「どのファイルが、なぜ一致したか」まで示し、CSV の表も PDF の本文も対象。日本語の形態素解析も内蔵しています。',
            doc: { guide: 'user-guide', hash: 'どのリソースが一致したか' },
          },
          {
            title: 'ダウンロードせずに見る',
            desc: 'CSV・JSON・GeoJSON・PDF・Office・一太郎をブラウザでそのままプレビュー。GeoJSON は地理院地図や OpenStreetMap の上に、表は並べ替えと絞り込みのできる形で。多いリソースは見出しで区切って整理できます。',
            doc: { guide: 'user-guide', hash: 'リソースのプレビュー' },
          },
        ],
      },
      {
        word: '問える',
        lead: 'ダウンロードして開く前に、その場で問い合わせられます。',
        items: [
          {
            title: 'SQL で問う',
            desc: '表形式のリソースには Data API が付き、ブラウザからも API からも SQL で問い合わせられます。必要な列と行だけを取り出し、集計もその場で。列の名前と型（スキーマ）も API で読め、AI エージェントも同じ口を使います。',
            doc: { guide: 'api/rest', hash: 'スキーマとデータクエリ' },
          },
          {
            title: '何が変わったかを問う',
            desc: 'ファイルを差し替えるたびに、前の内容を版として残します。過去の版はダウンロードでき、CSV/TSV は増えた行・減った行を、主キーを指定すれば行ごとの書き換えまで画面で確認。混入した個人情報は版単位で削除します。',
            doc: { guide: 'data-admin-guide', hash: 'バージョン管理' },
          },
          {
            title: 'まだ届くか問う（ヘルスチェック）',
            desc: '外部 URL のリソースは定期的に HEAD で死活を確かめ、中身が変わっていれば取り込み直します。結果とエラーになったリソースは管理画面で一覧。宣言されたフォーマットと中身の食い違いも、取得時に見つけます。',
            doc: { guide: 'system-admin-guide', hash: 'ヘルスチェック' },
          },
        ],
      },
      {
        word: 'つながる',
        lead: '人の画面だけでなく、AI エージェントや BI ツール、既存のツールからも使えます。',
        items: [
          {
            title: 'AI エージェントから',
            desc: 'MCP サーバーを内蔵。AI エージェントが自然文でデータセットを探し、文書の目次と本文を読み、表に SQL で問い合わせます。人が画面でできることを AI にも同じ入口から。Claude などの MCP 対応クライアントで使えます。',
            doc: { guide: 'api/mcp' },
          },
          {
            title: 'BI ツールから',
            desc: '表形式のリソースには OData の接続 URL が付きます。Excel・Tableau・Power BI の OData コネクタに貼るだけで、ダウンロードなしにその表を開けます。大きな表は分割して配信し、ツール側が続きを取りに行きます。',
            doc: { guide: 'user-guide', hash: 'bi-ツールで開く' },
          },
          {
            title: '既存のツールから',
            desc: 'CKAN 互換の読み取り API を備え、package_search や package_show をそのまま呼べます。CKAN 向けのクライアントや他カタログとの連携を保ったまま移行でき、REST API と API トークンも揃っています。',
            doc: { guide: 'api/ckan' },
          },
        ],
      },
    ],
    foundation: [
      {
        title: 'どこにでも置ける',
        desc: 'コンテナ構成で、AWS には同梱の CDK とデプロイパイプラインで、オンプレミスには Docker Compose で配備できます。閉域網（LGWAN 等）でも動きます。',
        doc: { guide: 'system-admin-guide', hash: 'デプロイ方法' },
      },
      {
        title: '1 つの基盤で複数のサイト',
        desc: '時間課金されるデータベースクラスタ・OpenSearch・ロードバランサーを複数のカタログサイトで共有。その中のデータベース・検索インデックス・バケットはサイトごとに分け、サイト追加の費用を小さく抑えます。',
        doc: { guide: 'system-admin-guide/multi-site' },
      },
      {
        title: '組織とグループで権限を分ける',
        desc: '組織とカテゴリー（グループ）の単位でメンバーの役割を持ち、データセットの公開・非公開と編集権限を管理。API トークンも同じ権限です。',
        doc: { guide: 'data-admin-guide', hash: '組織の管理' },
      },
      {
        title: 'オープンソース、日英、ブランド',
        desc: 'AGPL-3.0 でソースを公開。UI とドキュメントは日本語と英語を切り替えられ、配色・ロゴ・文言を自組織向けに上書きできます。',
        doc: { guide: 'system-admin-guide/brand-customization' },
      },
    ],
  },
  en: {
    title: 'KUKAN — A Data Catalog for Everyone',
    description:
      'Knowledge Unified Katalog And Network — an open-source data platform for people and AI: read, query, connect',
    tagline: 'A Data Catalog for Everyone',
    heroDesc: 'Read, query, connect. A data platform for people and AI.',
    docs: 'Docs',
    readDocs: 'Read the Docs',
    viewOnGitHub: 'View on GitHub',
    liveDemo: 'View the Live Demo',
    pillarsTitle: 'Read, query, connect.',
    pillarsLead: 'Publishing is where it starts. KUKAN stays with the data until it is actually used.',
    recentTitle: 'Recent Updates',
    foundationTitle: 'Built to Run',
    plannedNote: 'Coming up: SSO (OIDC) sign-in, and settled column types for CSV carried into diffs.',
    learnMore: 'Learn more',
    techTitle: 'Tech Stack',
    ctaTitle: 'Get Started',
    ctaDesc: 'Check the documentation for detailed setup instructions.',
    ctaButton: 'Go to Docs',
    ctaNote: 'Read about the story behind this project',
    releaseNotes: 'Release Notes',
    switchLang: '日本語',
    recent: [
      { title: 'Connect from a BI Tool', doc: { guide: 'user-guide', hash: 'opening-the-table-in-a-bi-tool' } },
      { title: 'Automatic File Descriptions', doc: { guide: 'data-admin-guide', hash: 'ai-written-descriptions' } },
      { title: 'Hybrid Search per Resource', doc: { guide: 'user-guide', hash: 'which-resource-matched' } },
    ],
    pillars: [
      {
        word: 'Read',
        lead: 'It interprets what it stores and shows it in a form people and AI both understand.',
        items: [
          {
            title: 'Reads it, writes the description',
            desc: 'Register a resource and an AI reads it and writes a short description: a table from its columns and first rows, a document from its text. Title, description and tag suggestions come from the same material, adopted field by field.',
            doc: { guide: 'data-admin-guide', hash: 'ai-written-descriptions' },
          },
          {
            title: 'Search inside the files',
            desc: 'Hybrid search by keyword and by meaning lands on a file, not just a dataset, and says which file matched and why. CSV tables and PDF text are both searchable, and Japanese morphological analysis is built in.',
            doc: { guide: 'user-guide', hash: 'which-resource-matched' },
          },
          {
            title: 'See it without downloading',
            desc: 'Preview CSV, JSON, GeoJSON, PDF, Office and Ichitaro files in the browser. GeoJSON renders on GSI or OpenStreetMap tiles, and tables sort and filter in place. Long resource lists fold under headings you drag into place.',
            doc: { guide: 'user-guide', hash: 'resource-preview' },
          },
        ],
      },
      {
        word: 'Query',
        lead: 'Ask the data a question before you download and open it.',
        items: [
          {
            title: 'Ask in SQL',
            desc: 'A tabular resource carries a Data API: query it in SQL from the browser or over the API, pull just the columns and rows you need, and aggregate on the spot. Column names and types come from the same API, for people and agents alike.',
            doc: { guide: 'api/rest', hash: 'schema-and-data-query' },
          },
          {
            title: 'Ask what changed',
            desc: 'Replacing a file keeps the old content as a version. Download any past version; for CSV/TSV see added and removed rows, or with a primary key how each row changed. A version that leaked personal data can be deleted on its own.',
            doc: { guide: 'data-admin-guide', hash: 'version-history' },
          },
          {
            title: 'Still reachable? Health checks',
            desc: 'External-URL resources get a scheduled HEAD check and are re-ingested when their content changes. Results and failing resources are listed in the dashboard, and a file whose declared format disagrees with its bytes is caught on fetch.',
            doc: { guide: 'system-admin-guide', hash: 'health-checks' },
          },
        ],
      },
      {
        word: 'Connect',
        lead: 'Not only through the web UI: from AI agents, BI tools and the tools you already have.',
        items: [
          {
            title: 'From AI agents',
            desc: "A built-in MCP server lets an AI agent find datasets in natural language, read a document's outline and sections, and query a table in SQL. Whatever a person can do on screen, an agent can do through the same door, from Claude or any MCP client.",
            doc: { guide: 'api/mcp' },
          },
          {
            title: 'From BI tools',
            desc: 'A tabular resource carries an OData connection URL. Paste it into the OData connector in Excel, Tableau or Power BI and the table opens with nothing to download. Large tables are served in pages the tool follows on its own.',
            doc: { guide: 'user-guide', hash: 'opening-the-table-in-a-bi-tool' },
          },
          {
            title: 'From the tools you have',
            desc: 'A CKAN-compatible read API answers package_search, package_show and the rest as-is, so CKAN clients and catalog federations keep working through a migration. A REST API and API tokens round out the programmatic side.',
            doc: { guide: 'api/ckan' },
          },
        ],
      },
    ],
    foundation: [
      {
        title: 'Runs anywhere',
        desc: 'Containers deploy to AWS with the bundled CDK and pipeline, or on-premises with Docker Compose. Air-gapped networks such as LGWAN work too.',
        doc: { guide: 'system-admin-guide', hash: 'deployment' },
      },
      {
        title: 'Many sites, one backbone',
        desc: 'Several catalog sites share the hourly-billed boxes: the database cluster, OpenSearch and the load balancer. Inside them each site keeps its own database, search index and bucket, so an added site costs little.',
        doc: { guide: 'system-admin-guide/multi-site' },
      },
      {
        title: 'Permissions by organization and group',
        desc: 'Members hold roles per organization and category (group), governing who sees and edits each dataset. API tokens carry the same permissions.',
        doc: { guide: 'data-admin-guide', hash: 'organization-management' },
      },
      {
        title: 'Open source, bilingual, brandable',
        desc: 'AGPL-3.0 with the full source open. UI and docs switch between Japanese and English; colors, logo and wording can be overridden per organization.',
        doc: { guide: 'system-admin-guide/brand-customization' },
      },
    ],
  },
} as const

// Release and date read the same in both locales; icons too.
const recentMeta = [
  { icon: '🔌', version: 'v0.31.0', date: '2026-09-24' },
  { icon: '📝', version: 'v0.30.0', date: '2026-09-18' },
  { icon: '🔎', version: 'v0.30.0', date: '2026-09-18' },
]
const pillarMeta = [
  { id: 'read', icon: '📖' },
  { id: 'query', icon: '🧮' },
  { id: 'connect', icon: '🔗' },
]
const foundationIcons = ['☁', '🏙', '🔒', '🌐']

// A doc link for the English page; the locale script rewrites it for Japanese.
const docHref = (doc: { guide: string; hash?: string }) =>
  `${base}en/${doc.guide}/${doc.hash ? `#${doc.hash}` : ''}`

const techStack = [
  'TypeScript',
  'Zod',
  'Next.js 16',
  'Tailwind CSS 4',
  'Hono',
  'Better Auth',
  'Drizzle ORM',
  'PostgreSQL',
  'pgvector',
  'OpenSearch',
  'DuckDB',
  'Parquet',
  'DuckLake',
  'Turborepo',
  'Vitest',
  'Playwright',
  'AWS CDK',
]
---

<!doctype html>
<html lang="en" data-locale="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {import.meta.env.PROD && (
      <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
      new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
      j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
      'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
      })(window,document,'script','dataLayer','GTM-NCMB89RM');</script>
    )}
    <title data-ja={t.ja.title} data-en={t.en.title}>{t.en.title}</title>
    <meta name="description" data-ja={t.ja.description} data-en={t.en.description} content={t.en.description} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" data-ja={t.ja.title} data-en={t.en.title} content={t.en.title} />
    <meta property="og:description" data-ja={t.ja.description} data-en={t.en.description} content={t.en.description} />
    <meta property="og:image" content={`https://kukan-project.github.io${base}og-image.png`} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline define:vars={{ translations: t, base }}>
      (function () {
        var stored = localStorage.getItem('kukan-locale')
        var lang = stored || (navigator.language.startsWith('ja') ? 'ja' : 'en')
        if (!stored) localStorage.setItem('kukan-locale', lang)
        if (lang === 'ja') {
          document.documentElement.lang = 'ja'
          document.documentElement.dataset.locale = 'ja'
          // Update meta tags before paint
          var title = document.querySelector('title')
          if (title) title.textContent = title.dataset.ja
          document.querySelectorAll('meta[data-ja]').forEach(function (el) {
            el.setAttribute('content', el.dataset.ja)
          })
        }
      })()
    </script>
  </head>
  <body>
    {import.meta.env.PROD && (
      <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-NCMB89RM" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}
    <header class="header">
      <div class="container header-inner">
        <a href={base} class="logo-link">
          <img src={`${base}logo.svg`} alt="KUKAN" width="32" height="32" />
          <span class="logo-text">KUKAN</span>
        </a>
        <nav class="nav">
          <a href={`${base}en/`} class="nav-link" data-i18n="docs">{t.en.docs}</a>
          <button type="button" class="nav-link lang-switch" data-i18n="switchLang" id="lang-switch">{t.en.switchLang}</button>
          <a href="https://github.com/kukan-project/kukan" target="_blank" rel="noopener" class="nav-btn">
            GitHub
            <svg class="ext-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
          </a>
        </nav>
      </div>
    </header>

    <section class="hero">
      <div class="hero-inner">
        <img src={`${base}logo.svg`} alt="KUKAN" width="96" height="96" class="hero-logo" />
        <h1 class="hero-title">KUKAN</h1>
        <p class="hero-subtitle">Knowledge Unified Katalog And Network</p>
        <p class="hero-tagline" data-i18n="tagline">{t.en.tagline}</p>
        <p class="hero-desc" data-i18n-html="heroDesc">{t.en.heroDesc}</p>
        <div class="hero-actions">
          <div class="hero-actions-row">
            <a href={`${base}en/`} class="btn-primary" data-i18n="readDocs" id="docs-link">{t.en.readDocs}</a>
            <a href="https://demo.kukan.dev/" target="_blank" rel="noopener" class="btn-outline">
              <span data-i18n="liveDemo">{t.en.liveDemo}</span>
              <svg class="ext-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
            </a>
          </div>
          <div class="hero-actions-row">
            <a href="https://github.com/kukan-project/kukan" target="_blank" rel="noopener" class="btn-outline">
              <span data-i18n="viewOnGitHub">{t.en.viewOnGitHub}</span>
              <svg class="ext-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
            </a>
            <a href="https://github.com/kukan-project/kukan/releases" target="_blank" rel="noopener" class="btn-outline btn-stacked">
              <span>
                <span data-i18n="releaseNotes">{t.en.releaseNotes}</span>
                <svg class="ext-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg>
              </span>
              <small class="btn-sub">{releasedOn ? `v${version} (${releasedOn})` : `v${version}`}</small>
            </a>
          </div>
        </div>
        <div class="hero-visual" aria-hidden="true">
          <div class="browser-frame bw-csv">
            <div class="bf-bar">
              <span class="bf-dot bf-red"></span>
              <span class="bf-dot bf-yellow"></span>
              <span class="bf-dot bf-green"></span>
              <span class="bf-url">demo.kukan.dev</span>
            </div>
            <img src={`${base}screens/demo-table.webp`} alt="" width="2392" height="1836" />
          </div>
          <div class="browser-frame bw-map">
            <div class="bf-bar">
              <span class="bf-dot bf-red"></span>
              <span class="bf-dot bf-yellow"></span>
              <span class="bf-dot bf-green"></span>
              <span class="bf-url">demo.kukan.dev</span>
            </div>
            <img src={`${base}screens/demo-map.webp`} alt="" width="2392" height="1576" />
          </div>
        </div>
      </div>
    </section>

    <section class="recent">
      <div class="container">
        <h2 class="recent-heading" data-i18n="recentTitle">{t.en.recentTitle}</h2>
        <div class="recent-list">
          {
            t.en.recent.map((r, i) => (
              <a href={docHref(r.doc)} class="recent-card" data-doc={`recent.${i}.doc`}>
                <span class="recent-icon" aria-hidden="true">{recentMeta[i].icon}</span>
                <span class="recent-body">
                  <span class="recent-title" data-i18n={`recent.${i}.title`}>{r.title}</span>
                  <span class="recent-date">{recentMeta[i].version} · {recentMeta[i].date}</span>
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section class="pillars">
      <div class="container">
        <h2 class="section-title" data-i18n="pillarsTitle">{t.en.pillarsTitle}</h2>
        <p class="section-lead" data-i18n="pillarsLead">{t.en.pillarsLead}</p>
        <div class="pillar-grid">
          {
            t.en.pillars.map((pillar, pi) => (
